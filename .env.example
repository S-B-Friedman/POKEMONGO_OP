# Credentials for `python run.py --source mysql`. Copy to .env and fill in.
#
# Nothing auto-loads this file -- pogo_opt/data.py reads the environment
# directly -- so export the values into your shell:
#
#   set -a; source .env; set +a
#
# .env is gitignored. Never commit real credentials.

# Required.
POGO_DB_USER=
POGO_DB_PASSWORD=

# Optional; defaults shown.
POGO_DB_HOST=localhost
POGO_DB_PORT=3306
POGO_DB_NAME=POGOR
